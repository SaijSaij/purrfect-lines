{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(source *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add*)",
      "Bash(npx *)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm add*)",
      "PowerShell(npx *)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm run check:release)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build)",
      "PowerShell(npm run preview)",
      "PowerShell(npm run check)",
      "PowerShell(npm run check:release)",
      "PowerShell(npm run e2e)",
      "PowerShell(npm run e2e *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-check.sh",
            "shell": "bash",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
