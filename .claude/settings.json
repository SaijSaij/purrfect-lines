{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(source *.env*)",
      "Bash(npx)",
      "Bash(npx *)",
      "Bash(cd)",
      "Bash(cd *)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)",
      "PowerShell(npx)",
      "PowerShell(npx *)",
      "PowerShell(Set-Location)",
      "PowerShell(Set-Location *)",
      "PowerShell(Push-Location *)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add*)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm add*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm run check:release)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build)",
      "PowerShell(npm run preview)",
      "PowerShell(npm run check)",
      "PowerShell(npm run check:release)",
      "PowerShell(npm run e2e)",
      "PowerShell(npm run e2e *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-check.sh",
            "shell": "bash",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
